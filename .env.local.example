# Copy to .env.local and fill in. .env.local is gitignored.
# Values live in the Railway project's variables tab — ask Ben if you
# don't have access. See LOCAL_DEV.md.

# --- Required ---------------------------------------------------------
# Either a local clone of the data (recommended — see "Working against a
# local copy of the database" in LOCAL_DEV.md):
#   DATABASE_URL=postgres://localhost:5432/gallery_dev
# or the Railway managed Postgres, which is the PRODUCTION database:
#   anything you do in /admin is live. Read LOCAL_DEV.md first.
DATABASE_URL=

# Dev server port. Defaults to 5000 if unset; 5070 matches the team.
PORT=5070

# --- Admin sign-in (/admin) -------------------------------------------
ADMIN_PASSWORD=
ADMIN_COOKIE_SECRET=

# --- Cloudflare R2 image storage --------------------------------------
# Only needed if you're uploading or processing images. Existing images
# load from the public CDN without these.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_ENDPOINT=
R2_PUBLIC_URL=https://pub-3b96f5fc8ba0456f9ffd861fc06e5e97.r2.dev

# --- Optional ---------------------------------------------------------
# AI-assisted features in the article editor.
ANTHROPIC_API_KEY=
